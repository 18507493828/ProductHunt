{
  "name": "vibe-building-server",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "migrate:json": "node migrate-json-to-mysql.js",
    "migrate:json:force": "node migrate-json-to-mysql.js --force",
    "seed:scenes": "node seed-scene-products.js",
    "ensure:scenes": "node --input-type=module -e \"import { initDb, pool } from './db.js'; import { ensureSceneProducts } from './ensureSceneProducts.js'; await initDb(); await ensureSceneProducts(); await pool.end();\"",
    "generate:apps": "node ../scripts/generate-real-apps.mjs",
    "sync:landings": "node ../scripts/sync-products.mjs patch-urls",
    "export:products": "node ../scripts/sync-products.mjs export",
    "import:products": "node ../scripts/sync-products.mjs import"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.24.4"
  }
}
